{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd shivangim-dynamic && npm install --no-audit --no-fund",
  "buildCommand": "cd shivangim-dynamic && npm run build",
  "outputDirectory": "shivangim-dynamic/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
